# Copy to .env.production (for builds) or .env.development.local (for npm run dev).
# Vite builds these values into the files, so rebuild after changing them.
# Only put public values here: anything starting with VITE_ is visible in the browser.

# Backend address. "https://host" and "https://host/api" both work.
# Leave empty in development to use the dev proxy below.
VITE_API_BASE_URL=

# npm run dev only: where /api requests are forwarded.
VITE_DEV_API_TARGET=http://localhost:5000
